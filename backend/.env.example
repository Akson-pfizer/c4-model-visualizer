# Copy this file to .env and adjust as needed.
# Pfizer LLMHub docs: https://docs.platforms.pfizer/llmhub/docs/llmhub-endpoints

# Required — Bearer token for https://llmhub.platforms.pfizer
LLMHUB_API_KEY=

# OpenAI-compatible root (NOT .../chat/completions — the SDK appends that path)
LLMHUB_BASE_URL=https://llmhub.platforms.pfizer/v1
LLMHUB_USER_AGENT=c4-model-visualizer/1.0

# Default tiers used by agents when the UI does not override `model`
LLMHUB_MODEL_POWERFUL=gpt-4o
LLMHUB_MODEL_MEDIUM=gpt-4.1-mini

# Comma-separated list shown in the UI "LLMHub model" dropdown
LLMHUB_MODEL_OPTIONS=gpt-4o,gpt-4.1,gpt-4.1-mini,gpt-4o-mini,o3-mini,o4-mini

# Optional path override
# LLMHUB_CONFIG_PATH=config/llmhub.yaml

# How long to wait for one LLMHub response
LLM_REQUEST_TIMEOUT_SECONDS=120

# Character budget for repo context fed to specialist agents
MAX_CONTEXT_CHARS=24000

PORT=8000

# Frontend origins allowed to call this API directly from the browser
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
