# Copy this file to .env and adjust as needed.

# LM Studio's local server (Developer tab -> Start Server, or `lms server start`)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Must match a model id currently loaded in LM Studio — run `lms ls` to see what's
# downloaded, `lms ps` to see what's actually loaded right now.
LM_STUDIO_MODEL=prism-ml/bonsai-27b

# How long to wait for one LLM response before giving up (local inference can be
# slow, especially on first load / without GPU offload)
LLM_REQUEST_TIMEOUT_SECONDS=120

# Character budget for repo context fed to the model — local models have much
# smaller usable context windows than cloud models, keep this conservative
MAX_CONTEXT_CHARS=24000

PORT=8000

# Frontend origins allowed to call this API directly from the browser
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
